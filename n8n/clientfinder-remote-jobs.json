{
  "name": "ClientFinder - Personalized Remote Job Discovery",
  "nodes": [
    {
      "parameters": {},
      "id": "7b1d1f0a-6a21-4d90-a2d7-3e62a9a1c001",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {"rule": {"interval": [{"field": "hours", "hoursInterval": 12}]}},
      "id": "7b1d1f0a-6a21-4d90-a2d7-3e62a9a1c002",
      "name": "Every 12 hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 500]
    },
    {
      "parameters": {
        "url": "https://www.arbeitnow.com/api/job-board-api",
        "sendQuery": true,
        "queryParameters": {"parameters": [{"name": "page", "value": "1"}]},
        "options": {"timeout": 30000}
      },
      "id": "7b1d1f0a-6a21-4d90-a2d7-3e62a9a1c003",
      "name": "Fetch Arbeitnow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 400]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const payload = $input.first().json;\nconst jobs = (payload.data || []).filter(job => job && job.remote === true).map(job => ({\n  source: 'arbeitnow',\n  external_id: String(job.slug || job.url || ''),\n  company_name: job.company_name || 'Unknown company',\n  title: job.title || '',\n  location: job.location || 'unknown',\n  remote: true,\n  tags: Array.isArray(job.tags) ? job.tags : [],\n  job_types: Array.isArray(job.job_types) ? job.job_types : [],\n  description: job.description || '',\n  source_url: job.url || '',\n  created_at: Number.isInteger(job.created_at) ? job.created_at : null\n})).filter(job => job.external_id && job.title && job.source_url);\nreturn [{ json: { jobs, remote_only: true } }];"
      },
      "id": "7b1d1f0a-6a21-4d90-a2d7-3e62a9a1c004",
      "name": "Normalize and keep remote jobs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/integrations/n8n/jobs",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {"timeout": 60000}
      },
      "id": "7b1d1f0a-6a21-4d90-a2d7-3e62a9a1c005",
      "name": "Send jobs to ClientFinder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1060, 400]
    }
  ],
